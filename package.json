{
  "name": "@bunbrowser/mcp",
  "version": "1.1.0",
  "description": "Ultra-fast Model Context Protocol (MCP) server for browser automation powered by Bun.WebView",
  "main": "src/index.ts",
  "type": "module",
  "homepage": "https://github.com/vintik100/bunbrowser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintik100/bunbrowser.git"
  },
  "bugs": {
    "url": "https://github.com/vintik100/bunbrowser/issues"
  },
  "bin": {
    "bunbrowser": "./bin/bunbrowser.ts",
    "bunbrowser-mcp": "./bin/bunbrowser.ts",
    "bunpw-mcp": "./bin/bunbrowser.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "bun tsc --noEmit && biome check ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bun",
    "bunbrowser",
    "webview",
    "playwright",
    "browser-automation",
    "llm",
    "ai"
  ],
  "author": "Vitaly",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
